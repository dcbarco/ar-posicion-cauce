{
  "name": "cauce-ar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mesa CAUCE — realidad aumentada sin marcador (WebXR) para la sala de apropiación social de CTeI",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "vendor": "node tools/copy-vendor.mjs",
    "predev": "node tools/copy-vendor.mjs",
    "prebuild": "node tools/copy-vendor.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "models:optimize": "node tools/models/optimize.mjs",
    "models:validate": "node tools/models/validate.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run models:validate",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/lexend": "5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.3",
    "@types/three": "0.186.0",
    "draco3dgltf": "1.5.9",
    "eslint": "10.13.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
